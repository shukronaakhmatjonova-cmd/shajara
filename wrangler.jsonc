{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shajara",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Baza birinchi deployda avtomatik yaratiladi (wrangler >= 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "shajara-db","database_id": "8b0d2e33-355d-48de-9539-a33ded3e92d4" }],
  "observability": { "enabled": true }
}
